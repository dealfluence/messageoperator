# Local AI/agent tooling — machine-specific, never part of the product.
# .kilo/kilo.json pins an absolute plugin path; graphify-out/ is a ~4MB
# generated knowledge graph that embeds this machine's filesystem layout.
.kilo/
.claude/
graphify-out/
# graphify's own git hooks pin an absolute interpreter path
# (C:\Users\<name>\...\python.exe); keep them locally, never publish them.
/.husky/post-commit
/.husky/post-checkout